<odoo>
    <record id="ai_business_copilot_log_tree" model="ir.ui.view">
        <field name="name">ai.business.copilot.log.tree</field>
        <field name="model">ai.business.copilot.log</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="created_on"/>
                <field name="lead_id"/>
                <field name="requested_by"/>
                <field name="request_type"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="ai_business_copilot_log_form" model="ir.ui.view">
        <field name="name">ai.business.copilot.log.form</field>
        <field name="model">ai.business.copilot.log</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <group>
                        <field name="lead_id"/>
                        <field name="requested_by"/>
                        <field name="request_type"/>
                        <field name="status"/>
                        <field name="created_on"/>
                    </group>
                    <notebook>
                        <page string="Input Preview"><field name="input_preview"/></page>
                        <page string="Response"><field name="response_text"/></page>
                        <page string="Error"><field name="error_message"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ai_business_copilot_log" model="ir.actions.act_window">
        <field name="name">AI Copilot Logs</field>
        <field name="res_model">ai.business.copilot.log</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_ai_business_copilot_log" name="AI Copilot Logs" parent="crm.crm_menu_config" action="action_ai_business_copilot_log" groups="sales_team.group_sale_manager,base.group_system"/>
</odoo>

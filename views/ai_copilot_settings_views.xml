<odoo>
    <record id="res_config_settings_view_form_ai_copilot" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai.copilot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="AI Business Copilot" name="ai_business_copilot" groups="base.group_system">
                    <block title="AI Provider">
                        <setting string="Enable AI Copilot">
                            <field name="ai_enable_copilot"/>
                        </setting>
                        <setting string="AI Provider">
                            <field name="ai_provider"/>
                        </setting>
                        <setting string="API Key">
                            <field name="ai_api_key" password="True"/>
                        </setting>
                        <setting string="Model Name">
                            <field name="ai_model_name"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
